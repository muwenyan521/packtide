pkgname=packtide
pkgver=0.1.0
pkgrel=1
pkgdesc='Package and system maintenance tools'
arch=('x86_64')
url='https://github.com/muwenyan521/packtide'
license=('MPL-2.0')
depends=('fzf>=0.74.0' 'pacman' 'sudo')
makedepends=('cargo' 'git')
optdepends=(
  'paru: AUR package helper'
  'yay: alternative AUR package helper'
  'flatpak: Flatpak package operations'
  'reflector: mirror-update command'
  'quicksave: Btrfs snapshot support'
  'grub: GRUB configuration refresh'
  'pacman-contrib: checkupdates command'
  'waybar: update signal refresh'
)
# Replace this URL with the maintainer's canonical public source before submission.
source=()
sha256sums=()

_srcdir="$startdir/../.."

build() {
  cd "$_srcdir"
  cargo build --release --locked --workspace
}

package() {
  cd "$_srcdir"
  DESTDIR="$pkgdir" PREFIX=/usr ./packaging/install.sh
}
